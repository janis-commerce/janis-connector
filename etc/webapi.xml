<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route method="POST" url="/V1/split-cart">
        <service class="JanisCommerce\JanisConnector\Api\ReloadPdpCalendarDataInterface" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>

    <!-- Requiere autenticacion: version de modulo, version de PHP y rutas del
         servidor son exactamente lo que se usa para fingerprinting, asi que
         este endpoint no puede ser anonymous. -->
    <route method="GET" url="/V1/janis-connector/system-information">
        <service class="JanisCommerce\JanisConnector\Api\SystemInformationInterface" method="execute"/>
        <resources>
            <resource ref="Magento_Backend::admin"/>
        </resources>
    </route>
</routes>
